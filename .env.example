# ====================================================================
# FinSight AI – Multi-Agent Financial Research System
# Environment Configuration (.env)
# ====================================================================

# 1. MongoDB Community Server Configuration
# Connect MongoDB Compass using this connection string:
MONGODB_URL=mongodb://localhost:27017/
DATABASE_NAME=finsight_db

# 2. JWT Authentication Secret Key
JWT_SECRET=finsight_ai_super_secret_jwt_key_change_in_production_2025

# 3. Google Gemini API Integration
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 4. Frontend & Server URLs
FRONTEND_URL=http://localhost:5173
PORT=8000

# 5. File Upload & PDF Report Generation Storage
UPLOAD_DIR=uploads
REPORT_DIR=generated_reports
